{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "outputDirectory": ".",
    "functions": {
        "dist/api/**/*.js": {
            "runtime": "nodejs24.x"
        }
    },
    "crons": [
        {
            "path": "/api/v2/cron",
            "schedule": "0 0 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        }
    ]
}
